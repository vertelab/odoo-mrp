<odoo>
    <record id="mrp_production_form_view_inherit_deadline" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.deadline</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <field name="date_finished" invisible="state == 'draft'" position="before">
                <field name="date_deadline"/>
            </field>
            <group name="group_extra_info" position="inside">
                <field name="date_deadline"/>
            </group>

        </field>
    </record>
</odoo>
