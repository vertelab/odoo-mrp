<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Shop Floor check types. The records belong to the upstream module's
            ``mrp_workorder`` (the Shop Floor flow), but the
            ``quality.point.test_type`` model comes from ``quality_ce``.
# They are loaded by ``post_init_hook`` (see ``__init__.py``)
            only when that model is registered, so that step 1 (planning)
            installs without the quality fork.
        -->
        <record id="test_type_register_consumed_materials" model="quality.point.test_type">
            <field name="name">Register Consumed Materials</field>
            <field name="technical_name">register_consumed_materials</field>
        </record>

        <record id="test_type_register_production" model="quality.point.test_type">
            <field name="name">Register Production</field>
            <field name="technical_name">register_production</field>
        </record>

        <record id="test_type_register_byproducts" model="quality.point.test_type">
            <field name="name">Register By-products</field>
            <field name="technical_name">register_byproducts</field>
            <field name="active" eval="False"/>
        </record>

        <record id="test_type_print_label" model="quality.point.test_type">
            <field name="name">Print label</field>
            <field name="technical_name">print_label</field>
        </record>
    </data>
</odoo>
