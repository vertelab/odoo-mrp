<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Shop Floor check types. The records belong to the upstream module's
            ``mrp_workorder`` (the Shop Floor flow), but the
            ``quality.point.test_type`` model comes from ``quality_ce``.
            Loading them from the manifest would break the install of step 1
            (planning), which must work without the quality fork, so they are
            loaded here through a method that checks the model registry first.
            See models/test_type_loader.py.
        -->
        <function name="load_shopfloor_test_types" model="mrp.workorder.test.type.loader"/>

        <record id="tablet_client_action" model="ir.actions.client">
            <field name="name">Tablet Client Action</field>
            <field name="tag">tablet_client_action</field>
            <field name="res_model">mrp_workorder</field>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('mrp_workorder_ce.group_mrp_wo_shop_floor'))]"/>
        </record>
    </data>
</odoo>
