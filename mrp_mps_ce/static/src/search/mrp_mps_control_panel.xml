<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="mrp_mps_ce.SearchBar" t-inherit="web.SearchBar">
        <xpath expr="//SearchBarMenu" position="replace">
            <MrpMpsSearchBarMenu/>
        </xpath>
    </t>

    <t t-name="mrp_mps_ce.SearchBarMenu" t-inherit="web.SearchBarMenu">
        <xpath expr="//Dropdown/t[@t-set-slot='content']/t[node()]" position="before">
            <GroupMenu items="env.model.data.groups[0]"/>
        </xpath>
    </t>

</templates>
